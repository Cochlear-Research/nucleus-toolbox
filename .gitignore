# Python byte-compiled / optimized / DLL files:
__pycache__/
*.py[cod]

# Python build files:
*.egg-info/

# MATLAB autosave files:
*.asv

# Doc files created by python scripts:
sphinx/source/_generated

# Log files produced by Run_nucleus_tests:
# We ignore most of them, but unignore those used to create a release report:
matlab/test_out/*
!matlab/test_out/result_20250610_16*.log
!matlab/test_out/result_20251002_16*.log

# Sphinx-built doc files:
build/
matlab/html/
*.mltbx
matlab/Sound_voc
